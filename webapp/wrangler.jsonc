{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dry-butterfly-8a6f",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker.js",
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "triggers": { "crons": ["0 * * * *"] },
  "vars": {
    "SUPABASE_REST_URL": "https://dcuorelcsmvrchkbjnqp.supabase.co/rest/v1",
    "ADMIN_EMAILS": "master1@example.com,master2@example.com,master3@example.com,master4@example.com,master5@example.com",
    "RELEASE_ANNOUNCEMENT": "체크리스트 기능이 추가되었습니다. 개인·공간 목록을 만들고, 핀에 필요한 목록을 복사해 항목별로 확인할 수 있습니다."
  },
  "routes": [
    {
      "pattern": "pintogether-photo.com",
      "custom_domain": true
    }
  ]
}
